{
  "name": "nef",
  "displayName": "nf",
  "description": "nf 语言支持：语法高亮、编译期错误提示、代码补全、悬停说明、转到定义、找引用、重命名与格式化文档，加上断点、单步、变量与内存视图的调试。",
  "version": "0.8.3",
  "publisher": "neflang",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers"
  ],
  "keywords": [
    "nf",
    "nef",
    "programming language",
    "language server",
    "debugger"
  ],
  "icon": "images/icon.png",
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:nf"
  ],
  "contributes": {
    "languages": [
      {
        "id": "nf",
        "aliases": [
          "nf",
          "Nef"
        ],
        "extensions": [
          ".nf"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "nf",
        "scopeName": "source.nf",
        "path": "./syntaxes/nf.tmLanguage.json"
      }
    ],
    "breakpoints": [
      {
        "language": "nf"
      }
    ],
    "debuggers": [
      {
        "type": "nf",
        "label": "nf",
        "languages": [
          "nf"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "要调试的 .nf 文件",
                "default": "${file}"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "交给程序的参数，程序里的 args 数组看得见",
                "default": []
              },
              "breakOnThrow": {
                "type": "boolean",
                "description": "没人接住的抛出停一下；有人接住的那一次不停",
                "default": false
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "nf",
            "request": "launch",
            "name": "调试当前文件",
            "program": "${file}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "nf：调试",
            "description": "运行一份 .nf 文件，在断点处停下",
            "body": {
              "type": "nf",
              "request": "launch",
              "name": "调试 ${1:文件}",
              "program": "^\"\\${workspaceFolder}/${2:main.nf}\"",
              "args": [
                "${3:参数}"
              ]
            }
          }
        ]
      }
    ],
    "configuration": {
      "title": "nf",
      "properties": {
        "nf.path": {
          "type": "string",
          "default": "",
          "description": "本机 nf.exe 的完整路径（Windows x64）。扩展不带编译器：留空时用 PATH 里的 nf，填了就用这一份，语言服务器与调试器都走它。"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "check": "node tools/check-grammar.mjs && node tools/check-highlight.mjs",
    "icon": "node tools/make-icon.mjs",
    "license": "node tools/make-license.mjs",
    "license:clean": "node tools/make-license.mjs --clean",
    "vscode:prepublish": "npm run compile && npm run icon && npm run license",
    "package": "vsce package && npm run license:clean"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.19.2",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.6.3",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
