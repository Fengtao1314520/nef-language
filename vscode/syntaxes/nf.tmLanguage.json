{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "nf",
  "scopeName": "source.nf",
  "fileTypes": [
    "nf"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#literals"
    },
    {
      "include": "#members"
    },
    {
      "include": "#names"
    },
    {
      "include": "#calls"
    },
    {
      "include": "#parameters"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.nf",
          "begin": "/\\*",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.nf"
            }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.nf"
            }
          }
        },
        {
          "name": "comment.line.double-slash.nf",
          "match": "//.*$",
          "captures": {
            "0": {
              "name": "punctuation.definition.comment.nf"
            }
          }
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "comment": "类型定义的名字：class、struct、interface、enum、type 后面那一个",
          "name": "entity.name.type.nf",
          "match": "(?<=\\b(?:class|struct|interface|enum|type)\\s)([A-Z_$]?[A-Za-z0-9_$]*)(?![\\w$])"
        },
        {
          "comment": "方法名：method 后面那一个",
          "name": "entity.name.function.nf",
          "match": "(?<=\\bmethod\\s)([A-Za-z_$][A-Za-z0-9_$]*)(?![\\w$])"
        },
        {
          "comment": "名字声明：let 与 const 后面那一个",
          "name": "variable.other.readwrite.nf",
          "match": "(?<=\\b(?:let|const)\\s)([A-Za-z_$][A-Za-z0-9_$]*)(?![\\w$])"
        },
        {
          "comment": "new 后面跟的是类型名",
          "name": "entity.name.type.nf",
          "match": "(?<=\\bnew\\s)([A-Z_$]?[A-Za-z0-9_$]*)(?![\\w$])"
        },
        {
          "comment": "继承与接口：base 与 implements 后面跟的是类型名",
          "name": "entity.name.type.nf",
          "match": "(?<=\\b(?:base)\\s)([A-Z_$]?[A-Za-z0-9_$]*)(?![\\w$])"
        },
        {
          "comment": "标注与转换的目标类型：冒号、as、is、尖括号后面大写开头的名字",
          "name": "entity.name.type.nf",
          "match": "(?<=\\b(?:as|is)\\s)([A-Z_$]?[A-Za-z0-9_$]*)(?![\\w$])"
        }
      ]
    },
    "literals": {
      "patterns": [
        {
          "name": "constant.numeric.hex.nf",
          "match": "\\b0[xX][0-9a-fA-F][0-9a-fA-F_]*\\b"
        },
        {
          "name": "constant.numeric.decimal.nf",
          "match": "\\b[0-9][0-9_]*(\\.[0-9_]+)?\\b"
        },
        {
          "name": "string.quoted.double.nf",
          "begin": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.nf"
            }
          },
          "end": "\"|$",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.nf"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.nf",
              "match": "\\\\(?:[nt\"\\\\]|u[0-9a-fA-F]{4})"
            }
          ]
        },
        {
          "name": "string.quoted.single.nf",
          "begin": "'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.nf"
            }
          },
          "end": "'|$",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.nf"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.nf",
              "match": "\\\\(?:[nt'\\\\]|u[0-9a-fA-F]{4})"
            }
          ]
        }
      ]
    },
    "members": {
      "patterns": [
        {
          "comment": "点号后面接着调用括号的：方法与组函数。中间那一截尖括号是写出来的类型实参（`cell.take<string>(k)`），跟着名字一起算",
          "name": "entity.name.function.nf",
          "match": "(?<=\\.)([A-Za-z_$][A-Za-z0-9_$]*)(?=\\s*(?:<[^<>]*(?:<[^<>]*>)?[^<>]*>)?\\s*\\()"
        },
        {
          "comment": "点号后面不接括号的：字段、枚举成员与静态名字",
          "name": "variable.other.property.nf",
          "match": "(?<=\\.)([A-Za-z_$][A-Za-z0-9_$]*)(?![\\w$])"
        }
      ]
    },
    "names": {
      "patterns": [
        {
          "name": "constant.language.nf",
          "match": "(?<![\\w$])(true|false|null)(?![\\w$])"
        },
        {
          "name": "keyword.control.nf",
          "match": "(?<![\\w$])(let|const|method|struct|class|interface|enum|type|fn|import|export|shared|base|this|new|return|as|is|throw|try|catch|finally|if|else|while|for|in|until|switch|default|break|continue)(?![\\w$])"
        },
        {
          "name": "storage.type.primitive.nf",
          "match": "(?<![\\w$])(boolean|int|float|byte|unicode|string|object|list|dict|hashset|Calendar|Json|bytes|Socket|Listener|Process|Thread|Response)(?![\\w$])"
        },
        {
          "comment": "标准库的组名（console、text、math 这些）",
          "name": "support.class.nf",
          "match": "(?<![\\w$])(console|text|number|math|time|file|path|environment|regular_expression|json|bytes|net|http|process|thread)(?![\\w$])"
        },
        {
          "comment": "没有点号也能调的那三个",
          "name": "support.function.nf",
          "match": "(?<![\\w$])(length|exit|args)(?![\\w$])"
        },
        {
          "comment": "自定义类型名一律大写开头，落在标注与转换的位置上",
          "name": "entity.name.type.nf",
          "match": "(?<![\\w$.])([A-Z][A-Za-z0-9_$]*)(?![\\w$])"
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "comment": "自己写的函数与方法的调用点：名字后面紧跟左括号；中间夹一对尖括号的（`twice<int>(1)`）也算调用点",
          "name": "entity.name.function.nf",
          "match": "(?<![\\w$.])([a-z_$][A-Za-z0-9_$]*)(?=\\s*(?:<[^<>]*(?:<[^<>]*>)?[^<>]*>)?\\s*\\()"
        }
      ]
    },
    "parameters": {
      "patterns": [
        {
          "comment": "参数表与字段表里的名字：后面是冒号与类型",
          "name": "variable.parameter.nf",
          "match": "(?<![\\w$.])([A-Za-z_$][A-Za-z0-9_$]*)(?=\\s*:(?!:))"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "comment": "长的分支必须排在前面：TextMate 取先命中的那一个，短的排前面会把 <= 切成 < 再加 =",
          "name": "keyword.operator.nf",
          "match": "(\\+\\+|--|==|!=|<=|>=|&&|\\|\\||<<|>>|\\+|-|\\*|/|%|!|=|<|>|&|\\||\\^|~)"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.section.block.begin.nf",
          "match": "\\{"
        },
        {
          "name": "punctuation.section.block.end.nf",
          "match": "\\}"
        },
        {
          "name": "punctuation.section.parens.begin.nf",
          "match": "\\("
        },
        {
          "name": "punctuation.section.parens.end.nf",
          "match": "\\)"
        },
        {
          "name": "punctuation.section.brackets.begin.nf",
          "match": "\\["
        },
        {
          "name": "punctuation.section.brackets.end.nf",
          "match": "\\]"
        },
        {
          "name": "punctuation.accessor.nf",
          "match": "\\."
        },
        {
          "name": "punctuation.separator.type.nf",
          "match": ":"
        },
        {
          "name": "punctuation.separator.comma.nf",
          "match": ","
        },
        {
          "name": "punctuation.terminator.statement.nf",
          "match": ";"
        }
      ]
    }
  }
}
